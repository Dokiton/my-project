# Қолданба параметрлері
PROJECT_NAME="Educational AI Platform"
ENVIRONMENT=development
DEBUG=True

# Деректер қоры (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=app_db
DATABASE_URL=postgresql+psycopg://postgres:your_postgres_password_here@localhost:5432/app_db

# Keycloak (OIDC)
KEYCLOAK_PORT=8080
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=edu-realm
KEYCLOAK_ISSUER=http://localhost:8080/realms/edu-realm
KEYCLOAK_JWKS_URL=
KEYCLOAK_CLIENT_ID=edu-web
KEYCLOAK_AUDIENCE=edu-api
KEYCLOAK_CLIENT_SECRET=your_keycloak_secret_here
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=your_keycloak_admin_password_here

# Жергілікті LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

